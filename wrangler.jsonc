{
  "name": "v",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    // 在 Cloudflare 后台 存储和数据库 → Workers KV 新建命名空间，把 ID 填到这里
    { "binding": "KV", "id": "109275ade98a49afbeb6fafbed370ac2" }
  ]
}
